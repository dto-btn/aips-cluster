# Business Requests database configuration (required)
BITS_DB_SERVER=your-db-server.domain
BITS_DB_USERNAME=your-database-username
BITS_DB_PWD=your-database-password
BITS_DB_DATABASE=your-database-name

# FastMCP HTTP server configuration (required for Kubernetes networking)
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000

# Optional: override the default ODBC driver installed in the image
# ODBC_DRIVER={ODBC Driver 18 for SQL Server}

# Optional: CORS configuration
# CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# CORS_ALLOW_CREDENTIALS=false
