# Core LiteLLM Configuration
LITELLM_MASTER_KEY=sk-1234567890
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_VERSION=2025-03-01-preview
LITELLM_DEFAULT_MODEL=azure/gpt-4o

# Database Configuration for External/Managed Postgres (postgres.enabled = false)
DATABASE_URL=postgresql://litellm_user:your_password@your-pg-server.postgres.database.azure.com:5432/litellm?sslmode=require
