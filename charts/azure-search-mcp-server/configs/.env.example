# Azure AI Search Configuration (Required)
AZURE_SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=your-index-name
AZURE_SEARCH_API_KEY=your-api-key

# Server Configuration (Optional)
MCP_SERVER_NAME="Azure AI Search MCP Server"
HOST=127.0.0.1
PORT=8000
CORS_ALLOW_ORIGINS="http://localhost:8080,http://localhost"

# Search Settings (Optional)
SEARCH_TOP_RESULTS=4

# Index Field Overrides (Optional - defaults are auto-detected)
# AZURE_SEARCH_KEY_FIELD=id
# AZURE_SEARCH_CONTENT_FIELD=content
# AZURE_SEARCH_VECTOR_FIELD=vector
# AZURE_SEARCH_SEMANTIC_CONFIG=my-semantic-config
